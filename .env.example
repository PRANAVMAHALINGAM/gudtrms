# Copy to .env and fill in. Never commit .env.

# Neon connection string. Each teammate should use their own Neon branch so test data doesn't collide.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: a read-only Postgres role for the judge view (it already reads inside READ ONLY transactions)
# JUDGE_DATABASE_URL=

# Messaging: terminal (local dev, default) or imessage (needs the two Spectrum keys below)
MESSAGING_PROVIDER=terminal

# Photon Spectrum (cloud mode), from app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# LLM (AGENTS.md section 3). Only claude is implemented; grok / gemini can be added in src/llm/.
LLM_PROVIDER=claude
# Optional: override the default model (claude-sonnet-5-5) and chat effort (low | medium | high)
LLM_MODEL=
LLM_EFFORT=low
# From console.anthropic.com. Check it with: npm run llm:check
ANTHROPIC_API_KEY=

# Advocate agents (AGENTS.md section 6). llm (default) or rules (no LLM calls, the v1 rules only)
ADVOCATE_MODE=llm
# How long an advocate waits for the LLM before falling back to the rules
ADVOCATE_TIMEOUT_MS=10000

# Leak filter (AGENTS.md section 6). The number/date check always runs. The LLM check on agent replies:
# on (default) or off. off = faster replies (~2s each) but only the number check.
LEAK_LLM_CHECK=on
# medium (default, accurate) or low (a bit faster, more false blocks)
LEAK_LLM_EFFORT=medium
# 1 prints blocked messages to the console. Fake data ONLY (privacy rule 6). Never on for real users.
LEAK_DEBUG=0

# Demo flags (AGENTS.md section 8)
# ROGUE_MODE: A or B makes that advocate try to send free text across once (true = B); false = off
ROGUE_MODE=false
# Wait between negotiation moves so judges can follow. 0 = no wait (dev, tests)
DEMO_PACING_MS=1500
