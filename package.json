{
  "name": "gudtrms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:reset": "tsx --env-file-if-exists=.env db/reset.ts",
    "demo:negotiate": "tsx --env-file-if-exists=.env db/negotiate-demo.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "msg:test": "tsx --env-file-if-exists=.env src/messaging/send-test.ts",
    "sim:router": "tsx --env-file-if-exists=.env db/router-sim.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
